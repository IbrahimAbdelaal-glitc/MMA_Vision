# Python
__pycache__/
*.py[cod]

# Generated analysis outputs and uploaded videos.
# They stay on disk; they are just not version-controlled.
# The leading slash matches only the project-root folders, so folders with
# these names elsewhere (for example inside frontend/) are still tracked.
/jobs/
/results/
/videos/

# Frontend
node_modules/
dist/
*.local

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Live sessions: uploads and engine output while a session runs.
/live_sessions/

# Local configuration: copy .env.example to .env (the defaults work as they are).
.env
!.env.example

# Evaluation outputs (keypoint caches, replays, reviews of local footage).
/validation/

# Browser-automation scratch files.
.playwright-mcp/
